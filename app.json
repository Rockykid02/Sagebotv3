{
  "name": "Sage-Bot-v3",
  "description": "Sage-Bot v3 — Advanced WhatsApp Multi-Device Bot by Sage Dickson, Powered by Digital Dynamo Lab",
  "repository": "https://github.com/Rockykid02/Sagebotv3",
  "keywords": ["whatsapp", "baileys", "bot", "sage-bot", "digital-dynamo-lab"],
  "env": {
    "MODE": {
      "description": "Bot mode (private or public)",
      "value": "private",
      "required": false
    },
    "PREFIXES": {
      "description": "Command prefixes (comma separated)",
      "value": ".",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Owner phone number (no + or country code)",
      "value": "263714296550",
      "required": false
    },
    "OWNER_NAME": {
      "description": "Owner name",
      "value": "Sage Dickson",
      "required": false
    },
    "SESSION": {
      "description": "Your Sage-Bot v3 session ID (get from session generator)",
      "required": true
    },
    "TZ": {
      "description": "Timezone",
      "value": "Africa/Nairobi",
      "required": false
    },
    "ANTICALL": {
      "description": "Auto reject calls (on/off)",
      "value": "on",
      "required": false
    },
    "ANTIDELETE": {
      "description": "Detect deleted messages (on/off)",
      "value": "on",
      "required": false
    },
    "ANTIEDIT": {
      "description": "Detect edited messages (on/off)",
      "value": "on",
      "required": false
    },
    "AUTO_READ": {
      "description": "Auto read incoming messages (on/off)",
      "value": "off",
      "required": false
    },
    "AUTO_VIEW": {
      "description": "Auto view status updates (on/off)",
      "value": "on",
      "required": false
    },
    "AUTO_LIKE": {
      "description": "Auto react to status updates (on/off)",
      "value": "off",
      "required": false
    },
    "DM_PRESENCE": {
      "description": "Presence type for private chats (typing/recording/online)",
      "value": "typing",
      "required": false
    },
    "GRP_PRESENCE": {
      "description": "Presence type for groups (typing/recording/online)",
      "value": "recording",
      "required": false
    },
    "USER_LID": {
      "description": "Your LID (leave empty if you don't have one)",
      "value": "",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "stack": "heroku-24"
}
